# Bazel builds both applications: Android with rules_android and rules_kotlin, iOS as in prototype A.
# Gradle builds the shared Kotlin code only: see AGENTS.md.

# Show why an action failed, and the log of a failing test, without another run.
build --verbose_failures
test --test_output=errors

# Java of the Android build. The Android tools and rules use Java 17 sources and run on Java 21.
# Robolectric needs Java 21 too, to run the Android 16 runtime of targetSdk 36.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# The released protoc, instead of a build of protoc from its C++ sources for the Android tools.
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# Dex and desugar in persistent workers rather than one JVM per library.
build --persistent_android_dex_desugar

# minSdk 26 has the Java 8 APIs: no desugared copy of the Java library in the APK.
build --@rules_android//flags:desugar_java8_libs=false

# Local settings that must not be committed.
try-import %workspace%/.bazelrc.user
